# Copy to ~/.config/ocfl/.env or point OCFL_ENV_FILE at it.
# The CLI rejects loose permissions on this file:
#   chmod 600 ~/.config/ocfl/.env

SIMPLEPROOF_ACCESS_TOKEN=replace-with-simpleproof-access-token
SIMPLEPROOF_API_KEY=replace-with-simpleproof-api-key

BITCOIN_RPC_USER=replace-with-bitcoin-rpc-user
BITCOIN_RPC_PASSWORD=replace-with-bitcoin-rpc-password

# Non-secret Bitcoin endpoints usually live in config.toml:
# [bitcoin]
# rpc_url = "http://127.0.0.1:8332"
# zmq_endpoint = "tcp://127.0.0.1:28332"
#
# Plain http:// is also accepted for Tailscale MagicDNS hosts:
# rpc_url = "http://bitcoin-host.tail-abc.ts.net:8332"
# zmq_endpoint = "tcp://bitcoin-host.tail-abc.ts.net:28332"
